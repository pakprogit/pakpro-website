{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "index.php",
      "storage/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "pakpro-laravel",
          "region": "africa-south1"
        }
      }
    ]
  }
}
